# Get a free API key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Set to true to use pre-computed demo responses (no API calls needed)
# Useful when demoing without internet or to avoid rate limits
DEMO_MODE=false

# Optional: protect /api/admin/* endpoints with a secret key
# If unset, admin endpoints are open (acceptable for local dev, not production)
# ADMIN_SECRET=change-me-in-production
